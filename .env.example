# Leardy env minta. A valodi ertekek nem ide, hanem secretbe mennek.
# Cloudflare Worker secret parancsok:
#   wrangler secret put AWS_ACCESS_KEY_ID
#   wrangler secret put AWS_SECRET_ACCESS_KEY
# Helyi fejleszteshez (wrangler dev) .dev.vars fajlba tedd ugyanezeket.

# Amazon SES regio, ahol a leardy@dezso.hu igazolva van.
AWS_REGION="eu-central-1"
# Fix felado az elfelejtett jelszo levelekhez.
SES_FROM_EMAIL="leardy@dezso.hu"
# IAM kulcs, csak SES SendEmail joggal.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
