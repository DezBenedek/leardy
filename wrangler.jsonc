{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "leardy",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "leardy",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "ASSETS_BUCKET",
			"bucket_name": "leardy-assets"
		}
	]
	// Durable Objects (QuizSession, RateLimiter) szándékosan NINCS itt:
	// az adapter-cloudflare generált _worker.js-e csak `default`-ot exportál,
	// DO-osztályt nem tudunk ugyanabban a Workerben publikálni.
	// Élő doga MVP: D1-alapú állapot + polling (tantermi léptékben elég),
	// a régi DO-s QuizSession-gép (old branch) később külön `apps/do`
	// Workerbe költözhet service bindinggal. Lásd README „Élő doga” rész.
}
