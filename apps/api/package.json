{
	"name": "leardy-api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --ip 0.0.0.0 --port 8787",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"types": "wrangler types",
		"db:generate": "echo 'Write SQL by hand in drizzle/. Schema snapshots are not used.' && exit 1",
		"db:migrate": "wrangler d1 migrations apply leardy --local",
		"db:migrate:remote": "wrangler d1 migrations apply leardy --remote"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@types/node": "^26.4.0",
		"@vitest/runner": "^4.1.11",
		"@vitest/snapshot": "^4.1.11",
		"drizzle-kit": "^0.31.10",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.1"
	}
}
