{
	"name": "leardy",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Leardy — nyelvtanulós PWA: szókártyák, leckéről leckére tanulás, tanterem élő dogával. SvelteKit + Cloudflare.",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "wrangler types src/worker-configuration.d.ts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"types": "wrangler types src/worker-configuration.d.ts",
		"deploy": "pnpm build && wrangler deploy",
		"cf:dev": "wrangler dev .svelte-kit/cloudflare/_worker.js"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250905.0",
		"@sveltejs/adapter-cloudflare": "^7.0.3",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@tailwindcss/vite": "^4.1.12",
		"@types/node": "^26.4.1",
		"clsx": "^2.1.1",
		"svelte": "^5.38.0",
		"svelte-check": "^4.3.0",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.12",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2",
		"vite": "^7.1.0",
		"wrangler": "^4.35.0"
	},
	"dependencies": {
		"bits-ui": "^2.19.0",
		"drizzle-orm": "^0.44.4",
		"lucide-svelte": "0.577.0",
		"mode-watcher": "1.1.0",
		"svelte-sonner": "1.2.1",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "1.4.0"
	}
}
