{
	"name": "leardy",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"cf:dev": "wrangler dev",
		"cf:deploy": "npm run build && wrangler deploy",
		"cf:db:create": "wrangler d1 create leardy-db",
		"cf:db:migrate": "wrangler d1 migrations apply leardy-db"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22.0.0",
		"@vite-pwa/sveltekit": "^1.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.42.0"
	},
	"type": "module"
}
